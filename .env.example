# --- URL du site (pour le sitemap, les métadonnées SEO et Open Graph) ---
NEXT_PUBLIC_SITE_URL=https://www.vaesocial.fr

# --- Envoi d'email pour les leads du formulaire de prédiagnostic (SMTP) ---
# Fonctionne avec n'importe quel fournisseur SMTP (OVH, Gmail, Brevo/Sendinblue, Resend, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=arthurpro@avenir-professionnel.fr
SMTP_PASSWORD=changeme
# Adresse qui reçoit les leads
LEADS_RECIPIENT_EMAIL=arthurpro@avenir-professionnel.fr
# Adresse d'expédition (souvent identique à SMTP_USER)
LEADS_FROM_EMAIL=arthurpro@avenir-professionnel.fr

# --- Tracking (SEO / Google Ads) ---
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXX
