# --- URL du site (pour le sitemap, les métadonnées SEO et Open Graph) ---
NEXT_PUBLIC_SITE_URL=https://vae-social.fr

# --- Envoi d'email pour les leads du formulaire de prédiagnostic (SMTP) ---
# Fonctionne avec n'importe quel fournisseur SMTP (OVH, Gmail, Brevo/Sendinblue, Resend, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=arthurpro@avenir-professionnel.fr
SMTP_PASSWORD=changeme
# Adresse qui reçoit les leads
LEADS_RECIPIENT_EMAIL=arthurpro@avenir-professionnel.fr
# Adresse d'expédition (souvent identique à SMTP_USER)
LEADS_FROM_EMAIL=arthurpro@avenir-professionnel.fr

# --- Google Sheets : ajout automatique de chaque lead comme nouvelle ligne ---
# Compte de service Google Cloud (JSON key), partagé en "Éditeur" sur le Sheet cible.
# Indépendant de l'envoi email : l'échec de l'un n'empêche jamais l'autre (voir
# app/api/prediagnostic/route.ts).
GOOGLE_SHEETS_CLIENT_EMAIL=xxx@xxx.iam.gserviceaccount.com
# Recommandé sur Hostinger : encoder la clé privée en base64 (une seule ligne,
# aucun caractère spécial, évite les soucis de formatage du champ texte).
# Pour l'obtenir : base64 -i service-account.json -o /dev/stdout (ou tout
# outil équivalent), puis n'encoder QUE le contenu du champ "private_key" du JSON.
GOOGLE_SHEETS_PRIVATE_KEY_BASE64=changeme
# Ancienne méthode, gardée en fallback si la variable ci-dessus est absente :
# GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXX\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=changeme

# --- Tracking (SEO / Google Ads) ---
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXX
